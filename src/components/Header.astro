---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { company, mail, nav } from '../content';
---

<header class="header">
  <div class="container bar">
    <a class="brand" href="/#top" aria-label={`${company.name} – home`}>
      <Logo size={34} class="mark" />
      <span class="name">{company.name}</span>
    </a>

    <button class="toggle" type="button" aria-expanded="false" aria-controls="nav" data-menu-toggle>
      <span class="bars" aria-hidden="true"></span>Menu
    </button>

    <nav id="nav" class="nav" aria-label="Main menu">
      <ul>
        {nav.map((n) => <li><a href={`/${n.href}`}>{n.label}</a></li>)}
      </ul>
      <a class="btn btn--primary cta" href={mail.demo}>
        <Icon name="mail" size={18} />Contact
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
  nav?.querySelectorAll('a[href*="#"]').forEach((a) =>
    a.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
    }),
  );
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--navy);
  }
  .name {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--deep);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding-block: 6px;
    border-bottom: 2px solid transparent;
  }
  .nav ul a:hover {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }
  .cta {
    min-height: 40px;
    padding: 8px 16px;
    font-size: 0.95rem;
  }
  .toggle {
    display: none;
    align-items: center;
    gap: 10px;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 8px 14px;
    min-height: 44px;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    position: relative;
  }
  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
  }
  .bars::before {
    top: -6px;
  }
  .bars::after {
    top: 6px;
  }
  @media (max-width: 899px) {
    .toggle {
      display: inline-flex;
    }
    .nav {
      display: none;
      position: absolute;
      inset: 68px 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 8px 16px 24px;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .nav.is-open {
      display: flex;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav ul a {
      display: block;
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
    }
    .cta {
      justify-content: center;
      min-height: 44px;
    }
  }
</style>
