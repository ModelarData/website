---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { company, mail, nav } from '../content';
---

<header class="header">
  <div class="container bar">
    <a class="brand" href="/#top" aria-label={`${company.name} – home`}>
      <Logo size={30} class="mark" />
      <span class="name">{company.name}</span>
    </a>

    <button class="toggle" type="button" aria-expanded="false" aria-controls="nav" data-menu-toggle>
      <span class="bars" aria-hidden="true"></span>Menu
    </button>

    <nav id="nav" class="nav" aria-label="Main menu">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
      <div class="actions">
        <a class="gh" href={company.github} rel="noopener">
          <Icon name="star" size={16} />GitHub
        </a>
        <a class="btn btn--primary cta" href={mail.demo}>Get a demo</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
  nav?.querySelectorAll('a[href*="#"]').forEach((a) =>
    a.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
    }),
  );
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(6 10 34 / 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 66px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--glow);
  }
  .name {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav ul {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.93rem;
    transition: color 0.15s;
  }
  .nav ul a:hover {
    color: #fff;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 6px 14px;
    border-radius: 9px;
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--mono);
    font-size: 0.85rem;
  }
  .gh:hover {
    border-color: rgb(255 255 255 / 0.3);
  }
  .gh :global(.icon) {
    color: #ffd166;
  }
  .cta {
    min-height: 38px;
    padding: 6px 16px;
    font-size: 0.92rem;
  }
  .toggle {
    display: none;
    align-items: center;
    gap: 10px;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: 9px;
    padding: 8px 14px;
    min-height: 44px;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    position: relative;
  }
  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
  }
  .bars::before {
    top: -6px;
  }
  .bars::after {
    top: 6px;
  }
  @media (max-width: 939px) {
    .toggle {
      display: inline-flex;
    }
    .nav {
      display: none;
      position: absolute;
      inset: 66px 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 8px 16px 24px;
      background: var(--bg-2);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 30px 60px rgb(0 0 0 / 0.5);
    }
    .nav.is-open {
      display: flex;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav ul a {
      display: block;
      padding: 14px 0;
      font-size: 1rem;
      color: var(--ink);
      border-bottom: 1px solid var(--line);
    }
    .actions > * {
      flex: 1;
      justify-content: center;
      min-height: 44px;
    }
  }
</style>
