---
// Inline SVG icons from Lucide (ISC).
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: cls } = Astro.props;

const lucide = import.meta.glob<string>('/node_modules/lucide-static/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const raw = lucide[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);

// Only the root <svg> tag is rewritten; inner shapes (e.g. <rect width>) must keep their attributes.
const svg = raw
  .replace(/<!--.*?-->/s, '')
  .replace(/<svg[^>]*>/, (tag) =>
    tag
      .replace(/\s(width|height|class)="[^"]*"/g, '')
      .replace(
        '<svg',
        `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" class="icon ${cls ?? ''}"`,
      ),
  );
---

<Fragment set:html={svg} />
