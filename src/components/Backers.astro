---
// Pitch-deck collaborators slide (project partners, advisory board) and funding sources (no amounts).
import Icon from './Icon.astro';
import { collaborators } from '../content';
---

<div class="backers">
  <div class="col">
    <h3><Icon name="handshake" size={20} />Project collaborators</h3>
    <ul>{collaborators.projects.map((p) => <li>{p}</li>)}</ul>
  </div>
  <div class="col">
    <h3><Icon name="users" size={20} />Advisory board</h3>
    <ul>
      {
        collaborators.advisors.map((a) => (
          <li>
            <strong>{a.name}</strong>
            <span>{a.role}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="col">
    <h3><Icon name="landmark" size={20} />Supported by</h3>
    <ul>{collaborators.funding.map((f) => <li>{f}</li>)}</ul>
  </div>
</div>

<style>
  .backers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 16px;
  }
  .col {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card-bg);
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.05rem;
    color: var(--heading);
    margin-bottom: 14px;
  }
  h3 :global(.icon) {
    color: var(--accent);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  li strong {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }
  @media (max-width: 899px) {
    .backers {
      grid-template-columns: 1fr;
    }
  }
</style>
