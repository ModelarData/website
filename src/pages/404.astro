---
// GitHub Pages serves 404.html for unknown paths (SWA redirected them to the front page).
import Layout from '../layouts/Layout.astro';
import { company } from '../content';
import { withBase } from '../lib/url';
---

<Layout title={`Page not found | ${company.name}`} description="The page you are looking for does not exist.">
  <div class="container wrap">
    <span class="kicker">404</span>
    <h1>Page not found</h1>
    <p>The page you are looking for does not exist or has moved.</p>
    <p><a href={withBase('/')}>Go to the front page</a></p>
  </div>
</Layout>

<style>
  .wrap {
    padding-block: clamp(48px, 7vw, 96px);
  }
  h1 {
    color: var(--heading);
  }
</style>
