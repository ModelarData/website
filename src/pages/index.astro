---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CodeTabs from '../components/CodeTabs.astro';
import {
  about,
  article,
  blogTeaser,
  builtOn,
  caseStudy,
  collaborators,
  company,
  contact,
  developers,
  getStarted,
  hero,
  mail,
  seo,
  stats,
  team,
  why,
} from '../content';
import { withBase } from '../lib/url';

const partnerImages = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/*.png', { eager: true });
const teamImages = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.jpg', { eager: true });
const partner = (file: string) => partnerImages[`../assets/partners/${file}.png`].default;
const photo = (file: string) => teamImages[`../assets/team/${file}.jpg`].default;
const initials = (name: string) =>
  name
    .split(' ')
    .filter((_, i, a) => i === 0 || i === a.length - 1)
    .map((p) => p[0])
    .join('');
const [compression, python, sql, deployment] = developers.features;

const orgId = `${company.url}/#organization`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: company.name,
      legalName: company.legalName,
      url: `${company.url}/`,
      logo: `${company.url}/apple-touch-icon.png`,
      email: company.email,
      address: { '@type': 'PostalAddress', addressCountry: company.country },
      sameAs: ['https://github.com/ModelarData'],
      member: team.map((p) => ({ '@type': 'Person', name: p.name, jobTitle: p.role })),
    },
    {
      '@type': 'SoftwareApplication',
      name: company.product,
      description: seo.description,
      applicationCategory: 'DatabaseApplication',
      isAccessibleForFree: true,
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      programmingLanguage: 'Rust',
      url: company.github,
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebSite',
      name: company.name,
      url: `${company.url}/`,
      publisher: { '@id': orgId },
    },
  ],
};
---

<Layout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section id="top" class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="orb orb--a" aria-hidden="true"></div>
    <div class="orb orb--b" aria-hidden="true"></div>

    <div class="container hero-grid">
      <div class="hero-copy">
        <ul class="badges" aria-label="Project facts">
          {hero.badges.map((b) => <li>{b}</li>)}
        </ul>
        <h1>
          {hero.h1.before} <span class="shine">{hero.h1.shine}</span>
          {hero.h1.after}
        </h1>
        <p class="lead">{hero.sub}</p>
        <div class="actions">
          <a class="btn btn--primary" href="#get-started">{hero.primary}<Icon name="arrow-right" size={18} /></a>
          <a class="btn btn--ghost" href={company.github} rel="noopener">
            <Icon name="star" size={18} class="star" />{hero.secondary}
          </a>
        </div>
      </div>
      <div class="hero-code">
        <CodeTabs />
      </div>
    </div>

    <div class="container">
      <p class="built-on">
        <span>Built on</span>
        {builtOn.map((b) => <span class="tech">{b}</span>)}
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats-band" aria-label="Key figures">
    <div class="container">
      <dl class="stats">
        {
          stats.map((s) => (
            <div>
              <dt class="shine">{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Why ModelarDB -->
  <section id="solution" class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Solution</span>
        <h2>{why.h2}</h2>
      </div>
      <ol class="why">
        {
          why.points.map((p, i) => (
            <li class="card">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <Icon name={p.icon} size={22} class="why-icon" />
              <span class="why-text">{p.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Developer features (bento) -->
  <section id="developers" class="section section--glow">
    <div class="container">
      <div class="section-head">
        <span class="kicker">For developers</span>
        <h2>{developers.h2}</h2>
      </div>

      <div class="bento">
        <article class="card tile tile--wide">
          <div class="tile-copy">
            <span class="tile-icon"><Icon name={compression.icon} size={20} /></span>
            <h3>{compression.title}</h3>
            <p>{compression.text}</p>
          </div>
          <!-- Illustration only: a raw signal (faint) and the few model segments that represent it. -->
          <svg class="viz viz--compress" viewBox="0 0 460 200" aria-hidden="true">
            <defs>
              <linearGradient id="seg" x1="0" x2="1">
                <stop offset="0" stop-color="#6578f4" /><stop offset="1" stop-color="#7ee0ff" />
              </linearGradient>
            </defs>
            <g stroke="rgb(255 255 255 / 0.06)">
              <line x1="0" y1="50" x2="460" y2="50" /><line x1="0" y1="100" x2="460" y2="100" />
              <line x1="0" y1="150" x2="460" y2="150" />
            </g>
            <polyline
              class="raw"
              fill="none"
              stroke="rgb(163 171 214 / 0.45)"
              stroke-width="1.3"
              points="0,150 10,142 18,156 28,134 38,146 48,120 58,136 68,110 78,124 88,100 98,112 108,86 118,102 128,80 138,96 148,72 158,90 168,70 178,84 188,64 198,92 208,82 218,108 228,96 238,122 248,110 258,138 268,126 278,150 288,140 298,160 308,146 318,156 328,128 338,136 348,104 358,116 368,82 378,94 388,62 398,76 408,46 418,58 428,32 438,44 460,24"
            />
            <polyline
              class="model"
              fill="none"
              stroke="url(#seg)"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"
              points="0,148 188,70 308,152 460,26"
            />
            <g fill="#fff">
              <circle cx="0" cy="148" r="4.5" /><circle cx="188" cy="70" r="4.5" />
              <circle cx="308" cy="152" r="4.5" /><circle cx="460" cy="26" r="4.5" />
            </g>
          </svg>
        </article>

        <article class="card tile">
          <span class="tile-icon"><Icon name={sql.icon} size={20} /></span>
          <h3>{sql.title}</h3>
          <p>{sql.text}</p>
          <code class="snippet"><b>SELECT</b> * <b>FROM</b> wind_turbine</code>
        </article>

        <article class="card tile">
          <span class="tile-icon"><Icon name={python.icon} size={20} /></span>
          <h3>{python.title}</h3>
          <p>{python.text}</p>
          <ul class="chips">
            <li>Jupyter</li><li>Pandas</li><li>PyTorch</li>
          </ul>
        </article>

        <article class="card tile tile--wide">
          <div class="tile-copy">
            <span class="tile-icon"><Icon name={deployment.icon} size={20} /></span>
            <h3>{deployment.title}</h3>
            <p>{deployment.text}</p>
          </div>
          <div class="flow" aria-hidden="true">
            <div class="node"><Icon name="cpu" size={22} /><span>Edge</span><small>collect · compress</small></div>
            <span class="wire"></span>
            <div class="node node--hot"><Icon name="cloud" size={22} /><span>Cloud</span><small>store</small></div>
            <span class="wire"></span>
            <div class="node"><Icon name="laptop" size={22} /><span>Client</span><small>query</small></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Blog teaser -->
  <section class="teaser-wrap" aria-label={blogTeaser.kicker}>
    <div class="container">
      <a class="card teaser" href={withBase(`/blog/${article.slug}/`)}>
        <span class="kicker">{blogTeaser.kicker}</span>
        <strong>{blogTeaser.title}</strong>
        <span class="teaser-text">{blogTeaser.text}</span>
        <span class="teaser-cta">{blogTeaser.cta}<Icon name="arrow-right" size={18} /></span>
      </a>
    </div>
  </section>

  <!-- Case study -->
  <section id="case-study" class="section">
    <div class="container case">
      <div>
        <span class="kicker">Case study</span>
        <h2>{caseStudy.h2}</h2>
        <div class="case-items">
          {
            caseStudy.items.map((c) => (
              <article class="case-item">
                <span class="tile-icon">
                  <Icon name={c.icon} size={20} />
                </span>
                <div>
                  <h3>{c.title}</h3>
                  <ul>
                    {c.points.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Illustration only: wind turbines and a solar panel in line art. -->
      <figure class="card case-art" aria-hidden="true">
        <svg viewBox="0 0 400 480">
          <defs>
            <linearGradient id="line" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#7ee0ff" /><stop offset="1" stop-color="#3c53f4" />
            </linearGradient>
            <radialGradient id="halo"><stop offset="0" stop-color="#6578f4" stop-opacity="0.45" /><stop offset="1" stop-color="#6578f4" stop-opacity="0" /></radialGradient>
          </defs>
          <circle cx="120" cy="160" r="150" fill="url(#halo)" />
          <g fill="none" stroke="url(#line)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M117 166 L113 386 M123 166 L127 386" />
            <g class="rotor" style="transform-origin: 120px 160px">
              <path d="M120 160 L114 66 L124 68 Z" />
              <path d="M120 160 L114 66 L124 68 Z" transform="rotate(120 120 160)" />
              <path d="M120 160 L114 66 L124 68 Z" transform="rotate(240 120 160)" />
            </g>
            <circle cx="120" cy="160" r="6" fill="#060a22" />
            <path d="M292 234 L289 386 M296 234 L299 386" />
            <g class="rotor rotor--slow" style="transform-origin: 294px 230px">
              <path d="M294 230 L290 166 L297 168 Z" transform="rotate(40 294 230)" />
              <path d="M294 230 L290 166 L297 168 Z" transform="rotate(160 294 230)" />
              <path d="M294 230 L290 166 L297 168 Z" transform="rotate(280 294 230)" />
            </g>
            <circle cx="294" cy="230" r="4.5" fill="#060a22" />
            <path d="M20 392 Q 120 372 200 388 T 380 384" opacity="0.5" />
            <path d="M40 452 L80 404 L360 404 L330 452 Z" />
            <path d="M60 428 L345 428 M150 404 L122 452 M222 404 L198 452 M292 404 L266 452" opacity="0.6" />
          </g>
          <g fill="#7ee0ff">
            <circle cx="60" cy="60" r="1.6" opacity="0.6" /><circle cx="330" cy="90" r="1.6" opacity="0.6" />
            <circle cx="360" cy="40" r="1.2" opacity="0.5" /><circle cx="210" cy="30" r="1.2" opacity="0.5" />
          </g>
        </svg>
      </figure>
    </div>
  </section>

  <!-- Get started -->
  <section id="get-started" class="section section--glow">
    <div class="container start">
      <div>
        <span class="kicker">Get started</span>
        <h2>{getStarted.h2}</h2>
        <p class="lead">{getStarted.sub}</p>
        <div class="actions">
          {
            getStarted.links.map((l, i) => (
              <a class={`btn ${i === 0 ? 'btn--primary' : 'btn--ghost'}`} href={l.href} rel="noopener">
                <Icon name={l.icon} size={18} />
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
      <ol class="steps">
        <li class="card">
          <span class="num">01</span>
          <div><strong>Clone</strong><code>git clone {company.cloneUrl}</code></div>
        </li>
        <li class="card">
          <span class="num">02</span>
          <div><strong>Build</strong><code>cargo build --release</code></div>
        </li>
        <li class="card">
          <span class="num">03</span>
          <div><strong>Run</strong><code>modelardbd edge path_to_local_data_folder</code></div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Collaborators -->
  <section id="collaborators" class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Partners</span>
        <h2>{collaborators.h2}</h2>
      </div>
      <ul class="logos">
        {
          collaborators.logos.map((l) => (
            <li>
              <Image src={partner(l.file)} alt={l.name} height={64} densities={[1, 2]} loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- About and team -->
  <section id="about" class="section section--glow">
    <div class="container">
      <div class="section-head">
        <span class="kicker">About us</span>
        <h2>{about.h2}</h2>
        {about.body.map((p) => <p class="lead">{p}</p>)}
      </div>
      <ul class="team">
        {
          team.map((p) => (
            <li class="card person">
              {p.photo ? (
                <Image src={photo(p.photo)} alt={p.name} width={160} height={160} fit="cover" loading="lazy" />
              ) : (
                <span class="avatar" aria-hidden="true">
                  {initials(p.name)}
                </span>
              )}
              <strong>{p.name}</strong>
              <span class="role">{p.role}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section">
    <div class="container">
      <div class="cta">
        <div class="cta-glow" aria-hidden="true"></div>
        <h2>{contact.h2}</h2>
        <p class="lead">{contact.sub}</p>
        <div class="actions">
          <a class="btn btn--primary" href={mail.demo}><Icon name="mail" size={18} />{hero.demo}</a>
          <a class="btn btn--ghost" href={mail.contact}>{company.email}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-block: clamp(56px, 8vw, 104px) 48px;
    overflow: hidden;
    isolation: isolate;
  }
  .grid-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 75%);
  }
  .orb {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }
  .orb--a {
    width: 560px;
    height: 560px;
    right: -120px;
    top: -140px;
    background: radial-gradient(circle, rgb(60 83 244 / 0.55), transparent 65%);
    animation: drift 14s ease-in-out infinite alternate;
  }
  .orb--b {
    width: 420px;
    height: 420px;
    left: -160px;
    top: 260px;
    background: radial-gradient(circle, rgb(126 224 255 / 0.22), transparent 65%);
    animation: drift 18s ease-in-out infinite alternate-reverse;
  }
  @keyframes drift {
    to {
      transform: translate(-40px, 40px) scale(1.08);
    }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.02fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
  }
  .badges li {
    font: 500 0.78rem var(--mono);
    color: var(--ink);
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--surface);
  }
  .badges li:first-child {
    color: #fff;
    border-color: rgb(139 155 255 / 0.5);
    background: rgb(60 83 244 / 0.22);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .actions :global(.star) {
    color: #ffd166;
  }
  .hero-code {
    min-width: 0;
  }
  .built-on {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 28px;
    margin: 72px 0 0;
    font: 0.85rem var(--mono);
    color: rgb(163 171 214 / 0.7);
  }
  .built-on > span:first-child {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
  }
  .tech {
    color: var(--ink);
    opacity: 0.8;
  }

  /* Stats */
  .stats-band {
    border-block: 1px solid var(--line);
    background: linear-gradient(90deg, transparent, rgb(60 83 244 / 0.08), transparent);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
  }
  .stats > div {
    padding: 36px 24px;
    border-left: 1px solid var(--line);
  }
  .stats > div:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stats dt {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .stats dd {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  /* Why */
  .why {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }
  .why li {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    min-height: 210px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .why li:hover {
    border-color: rgb(139 155 255 / 0.45);
    transform: translateY(-3px);
  }
  .num {
    font: 500 0.78rem var(--mono);
    color: var(--cyan);
  }
  .why :global(.why-icon) {
    color: var(--glow);
  }
  .why-text {
    margin-top: auto;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Glow sections */
  .section--glow::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(60% 50% at 50% 0%, rgb(60 83 244 / 0.16), transparent 70%);
    pointer-events: none;
  }
  .section--glow {
    isolation: isolate;
    border-top: 1px solid var(--line);
  }

  /* Bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .tile {
    padding: 28px;
    overflow: hidden;
  }
  .tile--wide {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 28px;
    align-items: center;
  }
  .tile h3 {
    margin-top: 18px;
  }
  .tile p {
    color: var(--muted);
    margin: 0;
    font-size: 0.98rem;
  }
  .tile-icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: #fff;
    background: linear-gradient(140deg, var(--mid), var(--navy));
    box-shadow:
      0 0 0 1px rgb(139 155 255 / 0.4) inset,
      0 6px 20px -6px rgb(60 83 244 / 0.8);
    flex: none;
  }
  .viz {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .viz .model {
    stroke-dasharray: 700;
    stroke-dashoffset: 700;
    animation: draw 2.4s 0.4s ease-out forwards;
    filter: drop-shadow(0 0 6px rgb(126 224 255 / 0.6));
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .snippet {
    display: block;
    margin-top: 20px;
    padding: 12px 14px;
    border-radius: 8px;
    background: rgb(0 0 0 / 0.3);
    border: 1px solid var(--line);
    font-size: 0.82rem;
    color: #dfe3ff;
  }
  .snippet b {
    color: var(--glow);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
  }
  .chips li {
    font: 0.8rem var(--mono);
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--surface);
  }
  .flow {
    display: flex;
    align-items: center;
  }
  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 18px 14px;
    min-width: 96px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--glow);
    text-align: center;
  }
  .node span {
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .node small {
    font: 0.7rem var(--mono);
    color: var(--muted);
  }
  .node--hot {
    border-color: rgb(139 155 255 / 0.55);
    box-shadow: 0 0 40px -6px rgb(60 83 244 / 0.7);
  }
  .wire {
    flex: 1;
    height: 2px;
    min-width: 16px;
    background: repeating-linear-gradient(90deg, var(--cyan) 0 6px, transparent 6px 12px);
    background-size: 24px 2px;
    opacity: 0.7;
    animation: flow 1s linear infinite;
  }
  @keyframes flow {
    to {
      background-position: 24px 0;
    }
  }

  /* Blog teaser */
  .teaser-wrap {
    padding-bottom: clamp(24px, 4vw, 48px);
  }
  .teaser {
    display: grid;
    gap: 8px;
    padding: clamp(24px, 4vw, 36px);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .teaser:hover {
    border-color: rgb(139 155 255 / 0.5);
    transform: translateY(-2px);
  }
  .teaser .kicker {
    margin-bottom: 4px;
  }
  .teaser strong {
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #fff;
  }
