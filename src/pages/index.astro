---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import {
  about,
  caseStudy,
  collaborators,
  company,
  contact,
  developers,
  getStarted,
  hero,
  mail,
  seo,
  team,
  why,
} from '../content';

const partnerImages = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/*.png', { eager: true });
const teamImages = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.jpg', { eager: true });
const partner = (file: string) => partnerImages[`../assets/partners/${file}.png`].default;
const photo = (file: string) => teamImages[`../assets/team/${file}.jpg`].default;
const initials = (name: string) =>
  name
    .split(' ')
    .filter((_, i, a) => i === 0 || i === a.length - 1)
    .map((p) => p[0])
    .join('');

const orgId = `${company.url}/#organization`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: company.name,
      legalName: company.legalName,
      url: `${company.url}/`,
      logo: `${company.url}/apple-touch-icon.png`,
      email: company.email,
      address: { '@type': 'PostalAddress', addressCountry: company.country },
      sameAs: ['https://github.com/ModelarData'],
      member: team.map((p) => ({ '@type': 'Person', name: p.name, jobTitle: p.role })),
    },
    {
      '@type': 'SoftwareApplication',
      name: company.product,
      description: seo.description,
      applicationCategory: 'DatabaseApplication',
      isAccessibleForFree: true,
      url: company.github,
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebSite',
      name: company.name,
      url: `${company.url}/`,
      publisher: { '@id': orgId },
    },
  ],
};
---

<Layout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section id="top" class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="kicker">{hero.kicker}</span>
        <h1>{hero.h1}</h1>
        <p class="lead">{hero.sub}</p>
        <div class="actions">
          <a class="btn btn--primary" href={mail.demo}><Icon name="mail" size={18} />{hero.primary}</a>
          <a class="btn btn--ghost" href={company.github} rel="noopener">
            <Icon name="git-branch" size={18} />{hero.secondary}
          </a>
        </div>
      </div>

      <!-- Illustration only: a raw signal and its compact model. No data. -->
      <figure class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 520 380" role="presentation">
          <rect x="0.5" y="0.5" width="519" height="379" rx="14" fill="#fff" stroke="#e1e4f2" />
          <g fill="#e3e6fc">
            <circle cx="28" cy="26" r="5" /><circle cx="46" cy="26" r="5" /><circle cx="64" cy="26" r="5" />
          </g>
          <g stroke="#eef0fb">
            <line x1="32" y1="90" x2="488" y2="90" /><line x1="32" y1="160" x2="488" y2="160" />
            <line x1="32" y1="230" x2="488" y2="230" /><line x1="32" y1="300" x2="488" y2="300" />
          </g>
          <polyline
            fill="none"
            stroke="#6578f4"
            stroke-width="1.6"
            stroke-linejoin="round"
            opacity="0.55"
            points="32,232 44,220 52,236 62,214 72,226 82,198 92,214 102,186 112,202 122,178 132,190 142,162 152,180 162,150 172,166 182,140 192,158 202,134 212,150 222,128 232,148 242,138 252,162 262,150 272,178 282,166 292,196 302,182 312,210 322,200 332,226 342,214 352,236 362,222 372,232 382,206 392,214 402,184 412,196 422,160 432,172 442,138 452,152 462,116 472,128 488,100"
          />
          <polyline
            fill="none"
            stroke="#2837a3"
            stroke-width="3.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            points="32,228 122,184 222,134 342,222 372,226 488,104"
          />
          <g fill="#3c53f4" stroke="#fff" stroke-width="2.5">
            <circle cx="32" cy="228" r="6" /><circle cx="122" cy="184" r="6" /><circle cx="222" cy="134" r="6" />
            <circle cx="342" cy="222" r="6" /><circle cx="372" cy="226" r="6" /><circle cx="488" cy="104" r="6" />
          </g>
          <g font-family="ui-monospace, monospace" font-size="13" fill="#4a5170">
            <rect x="32" y="322" width="456" height="36" rx="8" fill="#f6f7fe" />
            <text x="48" y="345"><tspan fill="#2837a3">SELECT</tspan> AVG(value) <tspan fill="#2837a3">FROM</tspan> sensor_data</text>
          </g>
        </svg>
      </figure>
    </div>
  </section>

  <!-- Why ModelarDB -->
  <section id="solution" class="section section--wash">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Solution</span>
        <h2>{why.h2}</h2>
      </div>
      <ul class="why">
        {
          why.points.map((p) => (
            <li>
              <span class="badge"><Icon name={p.icon} size={22} /></span>
              <span>{p.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Case study -->
  <section id="case-study" class="section">
    <div class="container case">
      <div>
        <span class="kicker">Case study</span>
        <h2>{caseStudy.h2}</h2>
        <div class="case-items">
          {
            caseStudy.items.map((c) => (
              <article class="case-item">
                <span class="badge"><Icon name={c.icon} size={22} /></span>
                <div>
                  <h3>{c.title}</h3>
                  <ul>
                    {c.points.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Illustration only: wind turbines and a solar panel. -->
      <figure class="case-art" aria-hidden="true">
        <svg viewBox="0 0 400 480" role="presentation">
          <rect width="400" height="480" rx="16" fill="#e3e6fc" />
          <circle cx="300" cy="96" r="38" fill="#fff" opacity="0.8" />
          <path d="M0 380 Q 100 350 200 372 T 400 360 V480 H0Z" fill="#c9cff8" />
          <g fill="#2837a3">
            <polygon points="117,160 123,160 127,384 113,384" />
            <polygon points="292,230 296,230 299,384 289,384" />
          </g>
          <g fill="#3c53f4">
            <g transform="translate(120 160)">
              <path d="M0 0 L-6 -96 L4 -94 Z" />
              <path d="M0 0 L-6 -96 L4 -94 Z" transform="rotate(120)" />
              <path d="M0 0 L-6 -96 L4 -94 Z" transform="rotate(240)" />
              <circle r="7" fill="#141c51" />
            </g>
            <g transform="translate(294 230)">
              <path d="M0 0 L-4 -64 L3 -62 Z" transform="rotate(40)" />
              <path d="M0 0 L-4 -64 L3 -62 Z" transform="rotate(160)" />
              <path d="M0 0 L-4 -64 L3 -62 Z" transform="rotate(280)" />
              <circle r="5" fill="#141c51" />
            </g>
          </g>
          <g transform="translate(40 400)">
            <polygon points="0,52 40,0 330,0 300,52" fill="#2837a3" />
            <g stroke="#6578f4" stroke-width="2">
              <line x1="20" y1="26" x2="315" y2="26" />
              <line x1="112" y1="0" x2="80" y2="52" /><line x1="184" y1="0" x2="160" y2="52" />
              <line x1="256" y1="0" x2="230" y2="52" />
            </g>
          </g>
        </svg>
      </figure>
    </div>
  </section>

  <!-- Get started -->
  <section id="get-started" class="section section--deep">
    <div class="container start">
      <div>
        <span class="kicker kicker--light">Get started</span>
        <h2>{getStarted.h2}</h2>
        <p class="lead lead--light">{getStarted.sub}</p>
        <div class="actions">
          {
            getStarted.links.map((l, i) => (
              <a class={`btn ${i === 0 ? 'btn--light' : 'btn--outline-light'}`} href={l.href} rel="noopener">
                <Icon name={l.icon} size={18} />
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
      <div class="terminal">
        <div class="terminal-bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <pre><code><span class="prompt" aria-hidden="true">$ </span>git clone {company.cloneUrl}</code></pre>
      </div>
    </div>
  </section>

  <!-- Developer features -->
  <section id="developers" class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">For developers</span>
        <h2>{developers.h2}</h2>
      </div>
      <div class="features">
        {
          developers.features.map((f) => (
            <article class="feature">
              <span class="badge"><Icon name={f.icon} size={22} /></span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Collaborators -->
  <section id="collaborators" class="section section--wash">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Partners</span>
        <h2>{collaborators.h2}</h2>
      </div>
      <ul class="logos">
        {
          collaborators.logos.map((l) => (
            <li>
              <Image src={partner(l.file)} alt={l.name} height={72} densities={[1, 2]} loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- About and team -->
  <section id="about" class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">About us</span>
        <h2>{about.h2}</h2>
        {about.body.map((p) => <p class="lead">{p}</p>)}
      </div>
      <h3 class="team-title">Team</h3>
      <ul class="team">
        {
          team.map((p) => (
            <li class="person">
              {p.photo ? (
                <Image src={photo(p.photo)} alt={p.name} width={160} height={160} fit="cover" loading="lazy" />
              ) : (
                <span class="avatar" aria-hidden="true">
                  {initials(p.name)}
                </span>
              )}
              <strong>{p.name}</strong>
              <span>{p.role}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section section--wash">
    <div class="container">
      <div class="contact">
        <div>
          <h2>{contact.h2}</h2>
          <p class="lead">{contact.sub}</p>
        </div>
        <div class="actions">
          <a class="btn btn--primary" href={mail.demo}><Icon name="mail" size={18} />{hero.primary}</a>
          <a class="btn btn--ghost" href={mail.contact}>{company.email}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(56px, 8vw, 104px);
    background:
      radial-gradient(60% 70% at 85% 30%, rgb(60 83 244 / 0.1), transparent 70%),
      linear-gradient(180deg, #fff, var(--wash));
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero h1 {
    color: var(--deep);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero-art {
    margin: 0;
    filter: drop-shadow(0 18px 40px rgb(20 28 81 / 0.12));
  }
  .hero-art svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .badge {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--tint);
    color: var(--navy);
    flex: none;
  }

  .why {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .why li {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    font-weight: 600;
    line-height: 1.4;
  }

  .case {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .case-items {
    display: grid;
    gap: 28px;
    margin-top: 36px;
  }
  .case-item {
    display: flex;
    gap: 18px;
  }
  .case-item h3 {
    margin-bottom: 6px;
  }
  .case-item ul {
    margin: 0;
    padding-left: 1.1em;
    color: var(--muted);
  }
  .case-item li + li {
    margin-top: 4px;
  }
  .case-art {
    margin: 0;
  }
  .case-art svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .kicker--light {
    color: #aab4fa;
  }
  .lead--light {
    color: #c9cff5;
  }
  .start {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .terminal {
    background: #0c1238;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 12px;
    overflow: hidden;
  }
  .terminal-bar {
    display: flex;
    gap: 6px;
    padding: 12px 14px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .terminal-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
  }
  .terminal pre {
    margin: 0;
    padding: 22px 20px;
    overflow-x: auto;
    color: #e3e6fc;
    font-size: 0.95rem;
  }
  .prompt {
    color: #6578f4;
    user-select: none;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .feature {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    transition: border-color 0.15s;
  }
  .feature:hover {
    border-color: var(--mid);
  }
  .feature h3 {
    margin-top: 18px;
  }
  .feature p {
    color: var(--muted);
    margin: 0;
  }

  .logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
  }
  .logos li {
    display: grid;
    place-items: center;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px 20px;
    min-height: 120px;
  }
  .logos img {
    max-height: 72px;
    width: auto;
  }

  .team-title {
    margin-bottom: 24px;
  }
  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 32px 16px;
  }
  .person {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
  }
  .person img,
  .avatar {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 12px;
    box-shadow: 0 0 0 4px var(--tint);
  }
  .person .avatar {
    display: grid;
    place-items: center;
    background: var(--tint);
    color: var(--navy);
    font-size: 2rem;
    font-weight: 700;
    color: var(--navy);
  }
  .person span {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: clamp(28px, 5vw, 48px);
    box-shadow: var(--shadow);
  }
  .contact h2 {
    color: var(--deep);
  }
  .contact .lead {
    margin: 0;
  }
  .contact .actions {
    margin-top: 0;
  }

  @media (max-width: 899px) {
    .hero-grid,
    .case,
    .start {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .case-art {
      max-width: 360px;
    }
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
